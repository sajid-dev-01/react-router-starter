{
  "name": "react-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "react-router dev",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "dev:email": "email dev --dir ./src/emails",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ui": "bunx --bun shadcn@latest",
    "migrations:generate": "drizzle-kit generate",
    "migrations:drop": "drizzle-kit drop",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun migrations:generate && bun db:push",
    "db:drop": "tsx ./src/db/drop.ts",
    "db:seed": "tsx ./src/db/seed.ts",
    "db:reset": "bun db:drop && bun db:migrate && bun db:seed"
  },
  "dependencies": {
    "@evyweb/ioctopus": "^1.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@libsql/client": "^0.14.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-email/components": "^0.0.31",
    "@react-router/node": "^7.1.5",
    "@react-router/serve": "^7.1.5",
    "@sentry/node": "^9.0.1",
    "@sentry/profiling-node": "^9.0.1",
    "@sentry/react": "^9.0.1",
    "@uploadthing/react": "^7.2.0",
    "arctic": "^2.3.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "input-otp": "^1.4.2",
    "inversify": "^6.2.2",
    "isbot": "^5.1.22",
    "kbar": "^0.1.0-beta.45",
    "lucide-react": "^0.468.0",
    "nuqs": "^2.3.2",
    "react": "^19.0.0",
    "react-day-picker": "^9.5.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "react-phone-number-input": "^3.4.11",
    "react-router": "^7.1.5",
    "recharts": "^2.15.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.1.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
